{
  "name": "scadaprofit-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint services/ollama/api tests/node",
    "lint:js:fix": "eslint services/ollama/api tests/node --fix",
    "lint:py": "ruff check services tests",
    "lint:py:fix": "ruff check --fix services tests",
    "format": "prettier --write services/ollama/api tests/node \"frontend/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check services/ollama/api tests/node \"frontend/src/**/*.{ts,tsx,css}\"",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix services/ollama run test && npm --prefix services/ollama run test:vdgo",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
