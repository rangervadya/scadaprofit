# Copy to .env and edit before the first deployment.
# These values are consumed by compose.yaml; see docs/deployment/DOCKER.md.

# Public HTTP port published by the gateway.
WEB_PORT=3001

# Set to 1 when HTTPS is terminated by the gateway or an upstream proxy.
COOKIE_SECURE=0

# Local Ollama model used for OCR and pipe-route tracing.
QWEN_MODEL=qwen3-vl:4b-instruct

# Node API verbosity: trace|debug|info|warn|error|fatal|silent.
LOG_LEVEL=info

# Maximum concurrent Python recognition jobs. Keep at 1 for a single GPU;
# /api/analyze returns 429 while a stored scheme is being processed.
MAX_CONCURRENT_PYTHON_JOBS=1

# VDGO upload safety. VDGO_MAX_REQUEST_BYTES caps the whole multipart request
# (default 256 MB). VDGO_MAX_FILE_BYTES caps a single file inside it
# (default 64 MB) so one huge image cannot exhaust RAM.
VDGO_MAX_REQUEST_BYTES=268435456
VDGO_MAX_FILE_BYTES=67108864
# Streaming multipart: body is spooled to RAM up to this size, then to disk.
VDGO_SPOOL_MAX_RAM_BYTES=8388608
# Max size of a single non-file form field.
VDGO_MAX_FIELD_BYTES=2097152

# Per-user heavy-operation quota (applied to /api/analyze, scheme upload/analyze,
# manual-CAD import). Keyed by account id when authenticated, IP otherwise.
HEAVY_QUOTA_WINDOW_MS=60000
HEAVY_QUOTA_LIMIT=30

# Time Node waits for active Python jobs after SIGTERM before SIGKILL.
SHUTDOWN_TIMEOUT_MS=20000

# Session idle timeout: a session is rejected after this much inactivity,
# independently of the 7-day absolute TTL (0 disables the idle check).
SESSION_IDLE_MS=43200000

# PostgreSQL is the only system of record. AUTH_BACKEND must be postgres;
# legacy JSON state stores were removed after the backup and the app now fails
# fast without a reachable database. Legacy JSON files are imported once when
# the DB is empty (one-time backfill), then ignored.
AUTH_BACKEND=postgres
DATABASE_URL=postgresql://vdgo:change_me_in_prod@localhost:5432/vdgo

# VDGO document service verbosity: DEBUG|INFO|WARNING|ERROR|CRITICAL.
VDGO_LOG_LEVEL=INFO

# Bundled PostgreSQL credentials. Set a unique password before deploying.
POSTGRES_USER=vdgo_app
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=vdgo

# VDGO PostgreSQL connection pool (psycopg_pool).
# VDGO_DB_POOL_MIN / VDGO_DB_POOL_MAX — min/max pooled connections.
# VDGO_DB_POOL_TIMEOUT — seconds to wait for a free connection (default 10).
# VDGO_DB_POOL_IDLE — max idle seconds before a connection is closed (default 300).
VDGO_DB_POOL_MIN=1
VDGO_DB_POOL_MAX=10
VDGO_DB_POOL_TIMEOUT=10
VDGO_DB_POOL_IDLE=300

# Optional override for the release label reported by the VDGO /health endpoint.
# APP_RELEASE=4.5.17
