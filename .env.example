# Copy to .env and edit before the first deployment.
# These values are consumed by compose.yaml; see docs/deployment/DOCKER.md.

# Public HTTP port published by the gateway.
WEB_PORT=3001

# Set to 1 when HTTPS is terminated by the gateway or an upstream proxy.
COOKIE_SECURE=0

# Local Ollama model used for OCR and pipe-route tracing.
QWEN_MODEL=qwen3-vl:4b-instruct

# Node API verbosity: trace|debug|info|warn|error|fatal|silent.
LOG_LEVEL=info

# VDGO document service verbosity: DEBUG|INFO|WARNING|ERROR|CRITICAL.
VDGO_LOG_LEVEL=INFO

# Bundled PostgreSQL credentials. Set a unique password before deploying.
POSTGRES_USER=vdgo_app
POSTGRES_PASSWORD=change_me_vdgo_2026
POSTGRES_DB=vdgo

# Optional override for the release label reported by the VDGO /health endpoint.
# APP_RELEASE=4.5.17