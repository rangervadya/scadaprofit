// Typed data layer for the PostgreSQL migration (P1-1).
//
// The Node app still reads users/sessions/workforce from JSON files. These models
// are the target schema: they let the team generate a typed client and write a
// repository before the expand-and-contract cutover. `report_runs` already exists
// in the VDGO database and is mapped as-is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReportRun {
  id              BigInt   @id @default(autoincrement())
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  report_number   String   @db.VarChar(120)
  report_date     String   @db.VarChar(20)
  output_format   String   @db.VarChar(30)
  page_count      Int      @default(0)
  output_filename String   @db.VarChar(255)

  @@map("report_runs")
}

// Created by the VDGO backend (services/vdgo/database.py). Declared here so the
// Prisma schema is the single inventory of the database: `prisma db push` drops
// tables it does not know about, and archive_entries is not one we can lose.
model ArchiveEntry {
  id                BigInt   @id
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  report_number     String   @default("") @db.VarChar(120)
  report_date       String   @default("") @db.VarChar(32)
  output_format     String   @db.VarChar(16)
  page_count        Int      @default(0)
  output_filename   String   @db.VarChar(255)
  original_filename String   @default("") @db.VarChar(255)
  content_type      String   @default("") @db.VarChar(120)
  file_size         BigInt   @default(0)
  archived_at       DateTime @default(now()) @db.Timestamptz(6)
  storage_path      String

  @@index([created_at])
  @@map("archive_entries")
}

model User {
  id            String    @id @db.Uuid
  username      String    @unique @db.VarChar(80)
  displayName   String    @map("display_name") @db.VarChar(120)
  firstName     String?   @map("first_name") @db.VarChar(80)
  lastName      String?   @map("last_name") @db.VarChar(80)
  role          String    @db.VarChar(20)
  passwordHash  String    @map("password_hash") @db.Text
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]

  @@map("users")
}

model Session {
  id         String   @id @db.VarChar(128)
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("sessions")
}

model RateLimitBucket {
  bucket      String   @db.VarChar(64)
  ident       String   @db.VarChar(255)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([bucket, ident])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model IdempotencyKey {
  id        String   @id @db.Uuid
  key       String   @db.VarChar(200)
  endpoint  String   @db.VarChar(120)
  userId    String?  @map("user_id") @db.Uuid
  status    String   @db.VarChar(20)
  response  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ManualCadProject {
  id        String   @id @db.Uuid
  title     String   @db.VarChar(200)
  data      Json
  revision  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt])
  @@map("manual_cad_projects")
}

/// Normalized address library (P1-14): replaces the address_library JSONB
/// singleton so streets/buildings/schemes can be queried by key.
model AddressStreet {
  id        String            @id @db.Uuid
  name      String            @db.VarChar(200)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  buildings AddressBuilding[]

  @@index([name])
  @@map("address_streets")
}

model AddressBuilding {
  id        String           @id @db.Uuid
  streetId  String           @map("street_id") @db.Uuid
  name      String           @db.VarChar(100)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  street    AddressStreet    @relation(fields: [streetId], references: [id], onDelete: Cascade)
  schemes   AddressScheme[]

  @@unique([streetId, name])
  @@index([streetId])
  @@map("address_buildings")
}

model AddressScheme {
  id           String          @id @db.Uuid
  buildingId   String          @map("building_id") @db.Uuid
  jobId        String          @unique @map("job_id") @db.Uuid
  title        String          @default("") @db.VarChar(400)
  status       String          @default("completed") @db.VarChar(32)
  sourceName   String?         @map("source_name") @db.VarChar(400)
  originalName String?         @map("original_name") @db.VarChar(400)
  uploadedBy   String?         @map("uploaded_by") @db.VarChar(200)
  error        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  building     AddressBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([status])
  @@map("address_schemes")
}

/// Normalized workforce tasks (P1-14): replaces the workforce_workspace JSONB
/// singleton for task reads. `data` keeps the full task payload so unknown
/// fields survive a round-trip.
model WorkforceTask {
  id               String   @id @db.Uuid
  title            String   @default("") @db.VarChar(400)
  status           String   @default("assigned") @db.VarChar(32)
  street           String   @default("") @db.VarChar(300)
  address          String   @default("") @db.VarChar(100)
  scheduledDate    String?  @map("scheduled_date") @db.VarChar(32)
  assignedTo       String?  @map("assigned_to") @db.Uuid
  assignedName     String?  @map("assigned_name") @db.VarChar(200)
  assignmentGroupId String? @map("assignment_group_id") @db.Uuid
  data             Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([assignedTo])
  @@index([scheduledDate])
  @@index([updatedAt])
  @@map("workforce_tasks")
}

/// Normalized workforce reports (sketches) — P1-14.
model WorkforceReport {
  id            String    @id @db.Uuid
  taskId        String?   @map("task_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  status        String    @default("pending_review") @db.VarChar(32)
  schemeJobId   String?   @map("scheme_job_id") @db.Uuid
  data          Json
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([taskId])
  @@index([userId])
  @@index([submittedAt])
  @@map("workforce_reports")
}

/// Normalized defect reports — P1-14.
model WorkforceDefectReport {
  id          String    @id @db.Uuid
  taskId      String?   @map("task_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  status      String    @default("pending_review") @db.VarChar(32)
  data        Json
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([taskId])
  @@index([userId])
  @@index([submittedAt])
  @@map("workforce_defect_reports")
}

model SchemeMeta {
  jobId     String   @id @map("job_id") @db.Uuid
  status    String   @db.VarChar(20)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([updatedAt])
  @@map("scheme_meta")
}