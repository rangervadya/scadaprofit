// Typed data layer for the PostgreSQL migration (P1-1).
//
// The Node app still reads users/sessions/workforce from JSON files. These models
// are the target schema: they let the team generate a typed client and write a
// repository before the expand-and-contract cutover. `report_runs` already exists
// in the VDGO database and is mapped as-is.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReportRun {
  id              BigInt   @id @default(autoincrement())
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  report_number   String   @db.VarChar(120)
  report_date     String   @db.VarChar(20)
  output_format   String   @db.VarChar(30)
  page_count      Int      @default(0)
  output_filename String   @db.VarChar(255)

  @@map("report_runs")
}

model User {
  id            String    @id @db.Uuid
  username      String    @unique @db.VarChar(80)
  displayName   String    @map("display_name") @db.VarChar(120)
  firstName     String?   @map("first_name") @db.VarChar(80)
  lastName      String?   @map("last_name") @db.VarChar(80)
  role          String    @db.VarChar(20)
  passwordHash  String    @map("password_hash") @db.Text
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]

  @@map("users")
}

model Session {
  id         String   @id @db.VarChar(128)
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model IdempotencyKey {
  id        String   @id @db.Uuid
  key       String   @db.VarChar(200)
  endpoint  String   @db.VarChar(120)
  userId    String?  @map("user_id") @db.Uuid
  status    String   @db.VarChar(20)
  response  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([key, endpoint])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model ManualCadProject {
  id        String   @id @db.Uuid
  title     String   @db.VarChar(200)
  data      Json
  revision  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([updatedAt])
  @@map("manual_cad_projects")
}

model AddressLibrary {
  id            Int      @id
  schemaVersion Int      @map("schema_version")
  data          Json
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("address_library")
}

model WorkforceWorkspace {
  id        Int      @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("workforce_workspace")
}